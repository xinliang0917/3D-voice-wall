# Backend
PORT=8787
WS_PATH=/ws/speech

# cloud = real cloud ASR through the backend proxy
# mock  = server-side mock adapter (simulates 500-1000ms recognition latency)
SPEECH_PROVIDER=cloud

# OpenAI-compatible /v1/audio/transcriptions endpoint.
# Keep SPEECH_API_KEY on the server only, never in src/ or .env.local.
# Local FunASR example:
# SPEECH_API_URL=http://127.0.0.1:8000/v1/audio/transcriptions
# SPEECH_API_KEY=local
# SPEECH_MODEL=iic/SenseVoiceSmall
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=

# Optional language hint sent to the ASR endpoint, e.g. zh, en, ja.
# Leave empty for auto-detect multilingual recognition.
SPEECH_LANGUAGE=

ASR_TIMEOUT_MS=120000

# In Auto mode, retry a Latin/pinyin-looking result with language=zh
# so Chinese speech is returned as Chinese characters instead of pinyin.
SPEECH_AUTO_RETRY_ZH=true

# In Auto mode, retry empty first-pass results with these language hints.
SPEECH_AUTO_LANGUAGES=ja,ko,th,fr,es,de,ru,ar,vi,id

# Frontend (build-time)
# cloud = CloudSpeechProvider through /ws/speech
# browser = native Web Speech API (development/testing only)
VITE_SPEECH_PROVIDER=cloud

# Leave empty in dev to use the Vite proxy or same-origin WebSocket in production.
VITE_WS_URL=
VITE_WS_PATH=/ws/speech
